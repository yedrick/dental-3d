# Copia este archivo a .env y cambia los valores. Nunca subas .env al repositorio.
PORT=4000
# Orígenes del frontend permitidos (CORS), separados por coma
CORS_ORIGIN=http://localhost:8080,http://localhost:5173
# Saltos de proxy de confianza (nginx, balanceador) para leer la IP real. 0 = tráfico directo
TRUST_PROXY=0

# --- tenancy-node ---
# Base central (tablas tenancy_*). El usuario necesita CREATE DATABASE, CREATE USER y GRANT OPTION:
# con él se crea la base dental_<sucursal> y un usuario MySQL propio para cada sucursal.
# En desarrollo se usa root del contenedor; en producción, un usuario dedicado (ver PLAN.md).
DATABASE_URL=mysql://root:root_dev_password@127.0.0.1:3307/dental3d_central
# Llave AES-256-GCM para cifrar las credenciales de cada sucursal: npx tenancy key:generate
# Guárdala en un gestor de secretos: si se pierde, no se pueden abrir las bases de las sucursales.
TENANCY_KEY=
# Las sucursales son subdominios de estos dominios (sur.localhost, sur.dental3d.com)
CENTRAL_DOMAINS=localhost
# Archivos públicos de cada sucursal (logos): storage/<sucursal>/branding/...
STORAGE_DIR=./storage

# --- JWT ---
# Mínimo 32 caracteres: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
