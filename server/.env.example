# Copia este archivo a .env y cambia los valores. Nunca subas .env al repositorio.
PORT=4000
# Procesos de la API (uno por núcleo que quieras usar). Con k6: 1 proceso ≈ 750 peticiones/s,
# 4 procesos ≈ 1500. Con más de 1, usa REDIS_URL y multiplica las conexiones a MySQL (ver abajo).
API_PROCESSES=1
# Interfaz donde escucha la API. Producción: 127.0.0.1 (solo nginx). Vacío = todas.
HOST=
# Orígenes del frontend permitidos (CORS), separados por coma
CORS_ORIGIN=http://localhost:8080,http://localhost:5173
# Saltos de proxy de confianza (nginx, balanceador) para leer la IP real en la API y en el panel /admin.
# Producción detrás de nginx: 1. 0 = tráfico directo
TRUST_PROXY=0
# Zona horaria del negocio para los filtros por día (Bolivia = -04:00)
BUSINESS_UTC_OFFSET=-04:00

# --- tenancy-node ---
# Base central (tablas tenancy_*). El usuario necesita CREATE DATABASE, CREATE USER y GRANT OPTION:
# con él se crea la base dental_<sucursal> y un usuario MySQL propio para cada sucursal.
# En desarrollo se usa root del contenedor; en producción, un usuario dedicado (tenancy_admin).
DATABASE_URL=mysql://root:root_dev_password@127.0.0.1:3307/dental3d_central
# Llave AES-256-GCM para cifrar las credenciales de cada sucursal: npx tenancy key:generate
# Guárdala en un gestor de secretos: si se pierde, no se pueden abrir las bases de las sucursales.
TENANCY_KEY=
# Conexiones del pool de la base central (por defecto 30). No crear más sucursales A LA VEZ que este
# número: tenancy-node 0.10.0 retiene una conexión por sucursal mientras la aprovisiona.
CENTRAL_POOL_MAX=30
# Pools de las sucursales. Conexiones máximas a MySQL ≈ (TENANT_POOL_MAX × sucursales activas + CENTRAL_POOL_MAX)
# × API_PROCESSES, y eso debe ser MENOR que max_connections de MySQL (151 por defecto).
# Ej.: 1 proceso: 5 × 60 + 30 = 330 → max_connections=400. 4 procesos y 20 sucursales: (3 × 20 + 10) × 4 = 280.
TENANT_POOL_MAX=5
TENANT_MAX_OPEN_POOLS=100
# Un pool sin uso se cierra a los N ms y libera sus conexiones
TENANT_POOL_IDLE_MS=60000
# Las sucursales son subdominios de estos dominios (sur.localhost, sur.dental3d.com)
CENTRAL_DOMAINS=localhost
# Archivos públicos de cada sucursal (logos, imágenes de la página web).
# STORAGE_DRIVER: local (por defecto, carpeta STORAGE_DIR), s3 (AWS, MinIO, Spaces...) o r2 (Cloudflare).
STORAGE_DRIVER=local
STORAGE_DIR=./storage
# Con s3 o r2 (en la base solo se guarda la ruta; los archivos van al bucket):
# S3_BUCKET=dental3d
# R2_ACCOUNT_ID=           # solo r2: id de la cuenta de Cloudflare (32 caracteres)
# S3_REGION=               # solo s3 (r2 usa auto)
# S3_ENDPOINT=             # MinIO u otro compatible: http://localhost:9000 (+ S3_FORCE_PATH_STYLE=true)
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=https://archivos.dental3d.com   # dominio público del bucket; sin esto, URLs firmadas
# Caché compartida (sesiones, catálogos, página web, reportes) por sucursal. Vacío = memoria del proceso.
# Recomendado en producción: REDIS_URL=redis://127.0.0.1:6379
REDIS_URL=
# Archivos PRIVADOS (comprobantes): solo se descargan con enlace firmado. Hacer respaldo.
PRIVATE_STORAGE_DIR=./storage-private

# --- JWT ---
# Mínimo 32 caracteres: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
# Hilos para bcrypt (login y cambios de contraseña), así no frenan las demás peticiones.
# Por defecto: núcleos − 1, entre 1 y 4.
# PASSWORD_WORKERS=3

# --- Correo y "¿Olvidaste tu contraseña?" (para TODAS las sucursales) ---
# Recuperar la contraseña con un código de 6 dígitos por correo. false = apagado (la app dice
# "pide a un administrador"). Sin MAIL_SMTP_HOST también queda apagado.
PASSWORD_RESET_ENABLED=true
# Datos SMTP de tu proveedor. Ejemplos:
#   Brevo:        smtp-relay.brevo.com · 587 · SECURE=false · usuario y clave SMTP de Brevo
#   Zoho:         smtp.zoho.com        · 465 · SECURE=true
#   Google:       smtp.gmail.com       · 465 · SECURE=true  (con "contraseña de aplicación")
#   Amazon SES:   email-smtp.<región>.amazonaws.com · 587 · SECURE=false
#   Local (Mailpit, no envía de verdad): 127.0.0.1 · 1025 · SECURE=false · sin usuario
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_SECURE=false
MAIL_SMTP_USER=
MAIL_SMTP_PASS=
# Remitente (el nombre de la sucursal se pone solo): debe ser un correo de tu dominio verificado
# en el proveedor (SPF/DKIM), si no los correos caen en spam.
MAIL_FROM=no-responder@dominio.com
# Quién recibe las solicitudes de "Solicitar demo" de la web comercial (vacío = solo quedan en el panel)
SALES_NOTIFY_TO=

# --- Web comercial (dominio principal). Se leen al compilar la web (npm run build) ---
# WhatsApp de ventas con código de país, solo números (ej. 59170000000). Vacío = sin botón de WhatsApp.
VITE_IONIX_WHATSAPP=
# Correo de contacto que se muestra en la web. Vacío = no se muestra.
VITE_IONIX_EMAIL=

# --- Panel de la plataforma (tenancy-node admin-api + admin-ui) en https://dominio.com/admin ---
# Secreto de las sesiones del panel (mínimo 32 caracteres): openssl rand -base64 48. Vacío = panel apagado.
TENANCY_ADMIN_SECRET=
# Cookies del panel con Secure. Solo en desarrollo por http: false
ADMIN_SECURE_COOKIES=true
# URL pública de cada sucursal ({tenant} = id). "Entrar como…" abre esta dirección.
TENANT_PUBLIC_URL=https://{tenant}.dominio.com
